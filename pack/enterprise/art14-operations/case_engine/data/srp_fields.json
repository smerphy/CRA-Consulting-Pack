{
  "_source": "ENISA SRP glossary as summarised in the KB: research_notes/EU CRA engineering compliance/reporting_obligations.md KQ2 (common, AEV-specific and SI-specific fields) and reports/guides/application/10-reporting-runbook.md 'Content by stage'. Levels: M = mandatory, R = required, O = optional, S = system-generated, '-' = not shown at that stage. Field order follows the glossary summary, not the live form, which may differ; re-check against the live form at every drill.",
  "date_format": "YYYY-MM-DD HH:MM UTC",
  "fields": [
    {"key": "notification_type", "label": "Notification type", "applies": "both", "levels": {"early_warning": "R", "notification": "R", "final_report": "R"}},
    {"key": "title", "label": "Title", "applies": "both", "max_len": 255, "levels": {"early_warning": "R", "notification": "R", "final_report": "R"}},
    {"key": "summary", "label": "Summary", "applies": "both", "max_len": 4000, "levels": {"early_warning": "R", "notification": "R", "final_report": "R"}},
    {"key": "manufacturer_name", "label": "Manufacturer name", "applies": "both", "levels": {"early_warning": "S", "notification": "S", "final_report": "S"}},
    {"key": "member_states", "label": "Member States where product available", "applies": "both", "levels": {"early_warning": "R", "notification": "R", "final_report": "R"}},
    {"key": "product_name_version", "label": "Product name and version", "applies": "both", "levels": {"early_warning": "R", "notification": "R", "final_report": "R"}},
    {"key": "product_class", "label": "Product type, class and category", "applies": "both", "levels": {"early_warning": "O", "notification": "O", "final_report": "O"}},
    {"key": "end_of_support", "label": "End-of-support indicator", "applies": "both", "levels": {"early_warning": "O", "notification": "O", "final_report": "O"}},
    {"key": "component_name", "label": "Component name", "applies": "both", "levels": {"early_warning": "O", "notification": "O", "final_report": "O"}},
    {"key": "aware_at", "label": "Date and time manufacturer became aware", "applies": "both", "levels": {"early_warning": "M", "notification": "M", "final_report": "M"}},
    {"key": "occurred_at", "label": "Date and time the AEV or incident occurred", "applies": "both", "levels": {"early_warning": "O", "notification": "O", "final_report": "O"}},
    {"key": "suspected_malicious", "label": "Incident suspected of unlawful or malicious acts", "applies": "severe_incident", "allowed": ["Yes", "No", "Unknown"], "levels": {"early_warning": "R", "notification": "R", "final_report": "R"}},
    {"key": "cve_id", "label": "CVE ID", "applies": "aev", "levels": {"early_warning": "O", "notification": "O", "final_report": "O"}},
    {"key": "euvd_id", "label": "EUVD ID", "applies": "aev", "levels": {"early_warning": "O", "notification": "O", "final_report": "O"}},
    {"key": "general_information", "label": "General information (product, nature of the exploit and vulnerability)", "applies": "aev", "levels": {"early_warning": "O", "notification": "R", "final_report": "R"}},
    {"key": "general_information_incident", "label": "General information on the nature of the incident", "applies": "severe_incident", "levels": {"early_warning": "O", "notification": "R", "final_report": "R"}},
    {"key": "initial_assessment", "label": "Initial assessment", "applies": "severe_incident", "levels": {"early_warning": "-", "notification": "R", "final_report": "R"}},
    {"key": "mitigation_expected_shortly", "label": "Mitigating measure expected shortly (Y/N)", "applies": "both", "levels": {"early_warning": "O", "notification": "O", "final_report": "O"}},
    {"key": "user_action", "label": "User action able to reduce impact", "applies": "both", "max_len": 4000, "levels": {"early_warning": "O", "notification": "O", "final_report": "O"}},
    {"key": "measures_taken", "label": "Corrective or mitigating measures taken", "applies": "both", "levels": {"early_warning": "O", "notification": "O", "final_report": "R"}},
    {"key": "measures_users", "label": "Corrective or mitigating measures users can take", "applies": "both", "levels": {"early_warning": "O", "notification": "O", "final_report": "R"}},
    {"key": "sensitivity", "label": "Considered sensitivity of information", "applies": "both", "levels": {"early_warning": "O", "notification": "O", "final_report": "-"}},
    {"key": "attack_vector", "label": "Attack vector", "applies": "both", "levels": {"early_warning": "-", "notification": "O", "final_report": "O"}},
    {"key": "pec_indicator", "label": "Particularly exceptional circumstances (PEC) indicator", "applies": "aev", "levels": {"early_warning": "-", "notification": "O", "final_report": "-"}},
    {"key": "pec_reason", "label": "PEC delay reason", "applies": "aev", "levels": {"early_warning": "-", "notification": "O", "final_report": "-"}},
    {"key": "fix_available_at", "label": "Date corrective or mitigating measure became available", "applies": "aev", "levels": {"early_warning": "-", "notification": "-", "final_report": "R"}},
    {"key": "security_update_details", "label": "Details of the security update", "applies": "aev", "levels": {"early_warning": "-", "notification": "-", "final_report": "R"}},
    {"key": "severity_impact", "label": "Description of severity and of impact (assessed severity rating, classification and rationale)", "applies": "aev", "levels": {"early_warning": "-", "notification": "-", "final_report": "R"}},
    {"key": "malicious_actor", "label": "Malicious actor", "applies": "aev", "max_len": 100, "levels": {"early_warning": "-", "notification": "-", "final_report": "R"}},
    {"key": "applied_mitigation", "label": "Applied and ongoing mitigation", "applies": "severe_incident", "levels": {"early_warning": "-", "notification": "-", "final_report": "R"}},
    {"key": "severity_impact_incident", "label": "Detailed severity and impact", "applies": "severe_incident", "levels": {"early_warning": "-", "notification": "-", "final_report": "R"}},
    {"key": "root_cause", "label": "Type of threat or root cause", "applies": "severe_incident", "levels": {"early_warning": "-", "notification": "-", "final_report": "R"}},
    {"key": "ar_note", "label": "AR note (free text)", "applies": "both", "levels": {"early_warning": "O", "notification": "O", "final_report": "O"}}
  ]
}
