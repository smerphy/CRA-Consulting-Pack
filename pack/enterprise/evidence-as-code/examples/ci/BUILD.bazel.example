# SKETCH ONLY. Not executable and not tested: //tools/cra:defs.bzl does not
# exist in this module, and a real rule would need a py_binary for
# cra_evidence with cryptography and sigstore as hermetic dependencies.
#
# Bazel-style integration (design illustration for a hermetic monorepo build).
#
# The gate is an ordinary build action: its inputs are the signed artefact,
# the SBOM, provenance, VEX, SARIF outputs, the release manifest, the gate
# policy and a feed snapshot pinned by digest. Because every input is pinned,
# the gate decision is reproducible: an auditor can rebuild the record from
# the stored inputs and get the same decision.

load("//tools/cra:defs.bzl", "cra_release_gate")

cra_release_gate(
    name = "lock3_cra_gate",
    release_dir = ":lock3_release_bundle",          # filegroup laid out as release.json + evidence/
    policy = "//tools/cra:aldermoor-gate-policy.json",
    feeds = "@cra_feeds_snapshot//:feeds",          # http_archive with sha256; refreshed daily by a bot PR
    tags = ["cra", "release-gate"],
)

